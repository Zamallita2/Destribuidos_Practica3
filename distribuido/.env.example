# Copia este archivo como "distribuido/.env" en LAS TRES PCs, con los mismos valores.
# Las IPs se ven en la app de Tailscale o con el comando:  tailscale ip -4
# Usa las IPs 100.x.x.x (no los nombres), porque Docker no siempre resuelve
# los nombres de Tailscale dentro de los contenedores.

# PC 1 · América: PostgreSQL América + servidor América (principal)
AM_HOST=100.64.0.1
# PC 2 · Europa: PostgreSQL Europa/Asia + servidor Europa
EU_HOST=100.64.0.2
# PC 3 · Asia: MongoDB + servidor Asia + gateway + frontend
AS_HOST=100.64.0.3

# Deben ser iguales en las tres PCs.
POSTGRES_PASSWORD=cambia-esta-clave
MONGO_PASSWORD=cambia-esta-clave
BOARDING_PASS_SECRET=cambia-este-secreto-compartido-2026

# Reglas de negocio
PERCENTAGE_SOLD=73
PERCENTAGE_RESERVED=3
REFUND_DELAY_MINUTES=15
