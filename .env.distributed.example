# Copiar a .env.distributed en las tres PCs y completar los mismos valores.
# Usar IP LAN fijas o reservas DHCP para esta demostracion.
PC_MONGO_IP=192.168.1.10
PC_AM_IP=192.168.1.11
PC_EU_IP=192.168.1.12

# Usar secretos alfanumericos largos; el mismo archivo en los tres equipos.
# No reutilizar las credenciales root/root del modo local.
POSTGRES_PASSWORD=CAMBIAR_CON_SECRETO_ALFANUMERICO
MONGO_PASSWORD=CAMBIAR_CON_OTRO_SECRETO_ALFANUMERICO
BOARDING_PASS_SECRET=CAMBIAR_CON_SECRETO_COMPARTIDO_DE_32_CARACTERES_O_MAS
